# sudo cp jarvis.service /etc/systemd/system/ && sudo systemctl enable --now jarvis
# Logs: journalctl -u jarvis -f
[Unit]
Description=Discord AI agent (smolagents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mitch
WorkingDirectory=/home/mitch/jarvis
ExecStart=/home/mitch/jarvis/.venv/bin/python main.py
Restart=always
RestartSec=10
Nice=5
# The Pi has 1 GB: if the agent ever balloons, restart it instead of letting the whole board thrash.
MemoryMax=600M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mitch/jarvis

[Install]
WantedBy=multi-user.target
