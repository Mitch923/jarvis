# sudo cp pi-agent.service /etc/systemd/system/ && sudo systemctl enable --now pi-agent
# Logs: journalctl -u pi-agent -f
[Unit]
Description=Discord AI agent (smolagents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-agent
ExecStart=/home/pi/pi-agent/.venv/bin/python main.py
Restart=always
RestartSec=10
Nice=5
# The Pi has 1 GB: if the agent ever balloons, restart it instead of letting the whole board thrash.
MemoryMax=600M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/pi-agent

[Install]
WantedBy=multi-user.target
