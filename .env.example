# ───────────── Required ─────────────
DISCORD_TOKEN=
# Comma-separated Discord user IDs allowed to use the bot. Everyone else is ignored.
DISCORD_ALLOWED_USER_IDS=
# You also need at least one LLM provider configured below (OpenRouter is the default; see
# the "LLM providers" section). By default that means OPENROUTER_API_KEY is required too.

# ───────────── Discord (optional) ─────────────
# Channels where the bot answers every message without needing an @mention (DMs and @mentions always work)
DISCORD_CHANNEL_IDS=

# ───────────── LLM providers ─────────────
# Tried in this order; each provider's own models (below) are tried in order before moving to
# the next provider. A daily quota hit on one provider falls through to the next immediately.
# Built-in names: openrouter, google, nvidia, ollama. Every provider listed here needs its
# credentials set, or startup fails with a clear error naming which one.
PROVIDERS=openrouter

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" = OpenRouter's free-model router. "auto" = at startup (and every 6h) look up
# currently-free models that support tool calling and append the newest few as fallbacks - free
# models rotate a lot, so this saves you edits. You can also pin IDs, e.g.
# MODELS=some-vendor/some-model:free,openrouter/free,auto
# (browse https://openrouter.ai/models?q=free&supported_parameters=tools for current IDs)
MODELS=openrouter/free,auto
AUTO_MODELS_LIMIT=4

# --- Google AI Studio / Gemini (https://aistudio.google.com/apikey - free tier, no card needed) ---
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Model names change; check https://ai.google.dev/gemini-api/docs/models for current free-tier ones.
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.0-flash

# --- NVIDIA NIM (https://build.nvidia.com - free tier with generous rate limits) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Browse https://build.nvidia.com/models for current model IDs and which support tool calling.
NVIDIA_MODELS=meta/llama-3.3-70b-instruct

# --- Ollama: point this at ANY OpenAI-compatible server, e.g. Ollama on another PC on your LAN ---
# (on that PC: `OLLAMA_HOST=0.0.0.0 ollama serve`, since Ollama only listens on localhost by
# default - then find its IP with `ip addr` / `ipconfig`). No API key needed for a private LAN box.
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.1

LLM_TIMEOUT=60              # seconds for one HTTP request
LLM_CALL_DEADLINE=150       # seconds for one LLM call including every retry/fallback/backoff
LLM_ATTEMPTS_PER_MODEL=2
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ───────────── Agent ─────────────
AGENT_TYPE=tool             # tool = safe JSON tool calls.  code = model writes Python that RUNS ON YOUR SERVER. Keep 'tool'.
MAX_STEPS=12                # each step = 1 LLM request; a free provider's own daily cap (e.g. OpenRouter's 50-1000/day) is the real limit, not RAM
RUN_TIMEOUT=420             # seconds for a whole task
HISTORY_TURNS=10            # past exchanges per channel given to the model as context
TOOL_OUTPUT_CHARS=16000     # cap on what any tool can put in the model's context
AGENT_TIMEZONE=UTC          # e.g. Pacific/Auckland

# ───────────── GitHub ─────────────
# Fine-grained personal access token limited to the repos you want. Leave empty to disable GitHub tools.
# Permissions: Contents RW, Pull requests RW, Issues R, Metadata R
GITHUB_TOKEN=
# Default owner for bare repo names like 'proj'. Blank = the token's own user.
GITHUB_OWNER=
# REQUIRED when GITHUB_TOKEN is set: the repos the agent (and watcher) may see, comma-separated owner/name.
# Free models can log prompts, so nothing outside this list is ever read or sent to them.
GITHUB_ALLOWED_REPOS=
# Set to 1 to skip the allowlist and expose everything the token can see (not recommended).
GITHUB_ALLOW_ALL=0
GITHUB_WRITE=1              # 0 = read-only (no edit / PR / review tools at all)
AGENT_BRANCH_PREFIX=agent/  # the agent can only commit to branches starting with this
# Which actions need an ✅ button press in Discord:
#   all      every commit, PR and review
#   publish  only opening PRs and posting reviews (commits to agent/* branches are automatic)
#   none     nothing (not recommended)
APPROVAL_MODE=publish
APPROVAL_TIMEOUT=180

# ───────────── Background jobs (plain GitHub polling: cost NO free-tier LLM requests) ─────────────
# Where alerts and the digest go. Blank = DM the first ID in DISCORD_ALLOWED_USER_IDS.
NOTIFY_CHANNEL_ID=
# Seconds between checks for new PRs / newly failing CI (minimum 60). 0 = watcher off.
WATCH_INTERVAL=300
# Daily digest time, 24h HH:MM in AGENT_TIMEZONE. Empty = no digest.
DIGEST_TIME=08:00

# ───────────── Self-improvement ─────────────
# Your bot's OWN GitHub repo (owner/name). It must also appear in GITHUB_ALLOWED_REPOS above.
# Blank = auto-detect from the git checkout's "origin" remote (works if you deploy via `git clone`).
SELF_REPO=
# Weekly self-review day: mon/tue/wed/thu/fri/sat/sun, or "off". Turns recorded friction (tool
# errors, LLM fallbacks, timeouts, step-limit hits, !feedback) into GitHub issues - never PRs.
SELF_REVIEW_DAY=sun
SELF_REVIEW_TIME=09:00      # HH:MM (24h) in AGENT_TIMEZONE
SELF_REVIEW_MIN_EVENTS=5    # fewer problem events than this since the last review -> skip it (saves LLM requests)
IMPROVE_MAX_STEPS=20        # step budget for !improve / !implement (separate from MAX_STEPS)
# Extra filename globs (beyond the built-in ones: tools.py, main.py, config.py, ghclient.py, run.py,
# updater.py, jarvis.service, requirements*.txt, .github/*, tests/*) the agent may never edit in ITS OWN repo.
PROTECTED_PATHS=

# ───────────── Local checkouts + sandboxed tests ─────────────
# repo_sync/repo_read/repo_grep: real `git clone`/fetch of allowed repos for fast local reading
# and full-text search (git grep - no extra dependency). Every checkout is a disposable mirror,
# hard-reset on every sync; it is never a second way to write code - commits still go through
# gh_edit_file/gh_write_file (the GitHub API) with the same branch guard and protected-file checks.
CHECKOUTS_ENABLED=1
# Where checkouts live (default: ./data/repos next to main.py). "should be plenty of space for a
# few repos" - each is a real clone, so budget accordingly against your disk.
CHECKOUT_DIR=
CHECKOUT_MAX_REPOS=6

# repo_test: runs a repo's own test suite in an ephemeral, resource-limited container - use it to
# verify an edit before opening a pull request. Needs Docker or Podman installed; if neither is
# on PATH, repo_test just reports that clearly and every other tool keeps working normally.
# 'docker', 'podman', or empty to turn repo_test off entirely (repo_sync/read/grep still work).
# NOTE ON PRIVILEGE: Docker typically needs the service user in the `docker` group, which is
# equivalent to root on this machine. Podman supports fully rootless use - prefer
# SANDBOX_RUNTIME=podman if you can, or a rootless Docker install. See jarvis.service.
SANDBOX_RUNTIME=docker
SANDBOX_TIMEOUT=300         # seconds before a test run is killed
SANDBOX_MEMORY=1g           # passed straight to the container runtime's --memory
SANDBOX_CPUS=1.5
# 'bridge' (default) lets the container reach the network, which most projects need to install
# dependencies (pip/npm/...). 'none' fully air-gaps the run - use it for repos with vendored or
# no external dependencies. Either way, no secrets are ever passed into the container.
SANDBOX_NETWORK=bridge
# Per-repo test command overrides, ';'-separated "owner/repo=command" (or "owner/repo=image:tag|command"
# to also pick the image). "*" is a fallback for repos with no specific entry. Auto-detected from
# common project files (tests/run_all.py, requirements.txt, package.json, go.mod, Cargo.toml) when
# no override matches; if none of that fits, repo_test reports it and tells you what to set here.
# Example: TEST_COMMANDS=me/site=npm run test:ci;me/api=python -m pytest -q
TEST_COMMANDS=

# ───────────── Storage ─────────────
# Long-term notes, watcher state and the friction log live here (default: ./data next to main.py)
DATA_DIR=
MEMORY_MAX_NOTES=40

LOG_LEVEL=INFO
